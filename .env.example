# Copy to .env and fill in. Never commit .env.

# FalkorDB
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_PASSWORD=

# Hugging Face (read token is required; write token only for allowlisted test repos)
HF_TOKEN=
HF_WRITE_TOKEN=
HF_POST_ALLOWLIST=your-hf-user/modelbrain-loop-test

# Optional LLM via OpenRouter for explanations, drafts, the Ask router and eval baselines (templates are used when empty)
OPENROUTER_API_KEY=
LLM_MODEL=                                 # required if OPENROUTER_API_KEY is set: an exact id from https://openrouter.ai/api/v1/models (a fast, cheap model)
LLM_DAILY_BUDGET_CALLS=500
EVAL_BASELINE_MODELS=                      # comma-separated OpenRouter model ids for the card-only baseline

# Hosted path (public OpenRouter catalogue; no key needed)
OPENROUTER_CATALOG_REFRESH_HOURS=12

# Web fetcher for licence texts and custom licence links: httpx (default), firecrawl or anakin
WEB_FETCHER=httpx
FIRECRAWL_API_KEY=
ANAKIN_API_KEY=

# Security
ADMIN_TOKEN=change-me
PUBLISHER_SALT=change-me-long-random
CORS_ORIGINS=http://localhost:3001,https://your-app.vercel.app

# Jobs
WATCH_INTERVAL_MINUTES=10
SANDBOX_TTL_MINUTES=120

# Weight DNA (docs/ADDENDUM_WEIGHT_DNA.md). The vector index dimension is 2 x DNA_PER_TENSOR.
DNA_PER_TENSOR=512
DNA_DERIVED_MIN=0.60
DNA_RELATED_MIN=0.25

# Web app (apps/web/.env.local)
NEXT_PUBLIC_API_URL=http://localhost:8000
